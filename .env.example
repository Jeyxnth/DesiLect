# Copy to .env (optional). No secrets or accounts are needed (G8).

# Local LLM served by Ollama on this machine
OLLAMA_URL=http://localhost:11434
# TODO(step 5): pick the final model and record its licence in LICENSES.md
OLLAMA_MODEL=qwen2.5:3b

# Paths (relative to repo root)
MODELS_DIR=models
OUTPUTS_DIR=outputs

# Backend
HOST=127.0.0.1
PORT=8000

# Forced on by the app at runtime (H2); listed for clarity
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
