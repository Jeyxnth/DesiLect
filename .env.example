# Copy to .env (optional). No secrets or accounts are needed (G8).

# Local LLM served by Ollama on this machine
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: 0 forces CPU-only inference even if a GPU is present (to measure a CPU-only laptop)
# OLLAMA_NUM_GPU=0

# Paths (relative to repo root)
MODELS_DIR=models
OUTPUTS_DIR=outputs

# Voice (step 9). Tamil engine: parler (Indic Parler-TTS) or the Plan B engine if built, see README
# TAMIL_TTS=parler
# Speak English terms in Hindi/Tamil lessons via the transliteration table in shared/glossary.json (0 = off)
# TTS_TRANSLIT=1

# Backend
HOST=127.0.0.1
PORT=8000

# Forced on by the app at runtime (H2); listed for clarity
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
