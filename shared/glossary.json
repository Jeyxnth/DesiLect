{
  "_comment": "Terms kept in English inside translated narration (G5). Used by backend/app/translate/protect.py. Matching is whole-word and case-insensitive; longer terms win.",
  "keep_english": [
    "Python", "JavaScript", "loop", "loops", "for loop", "while loop", "if statement", "range", "print",
    "variable", "variables", "function", "list", "lists", "string", "code", "True", "False", "None", "len",
    "append", "array", "item", "items", "index", "target", "mid", "sorted", "binary search", "algorithm",
    "photosynthesis", "chlorophyll", "glucose", "oxygen", "carbon dioxide", "CO2",
    "Pythagorean theorem", "hypotenuse"
  ],
  "keep_patterns": [
    "`[^`]+`",
    "\\b[A-Za-z_]\\w*\\([^()]*\\)",
    "\\b[A-Za-z_]\\w*\\s*[-+*/]?=\\s*[A-Za-z0-9_.]+",
    "\\b[A-Za-z]+_[A-Za-z0-9_]+\\b",
    "\\b\\d+(?:\\.\\d+)?\\b"
  ],
  "preferred": {
    "hi": { "program": "प्रोग्राम", "screen": "स्क्रीन" },
    "ta": { "program": "program", "screen": "திரை" }
  }
}
