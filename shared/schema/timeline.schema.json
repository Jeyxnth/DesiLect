{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline",
  "description": "Built by backend/app/timing/timeline.py from per-sentence audio. All times are absolute seconds in the lesson. 'data' is the scene object from lesson.schema.json (#/$defs/scene); validate.py checks it against that definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson_id", "language", "total_seconds", "audio_url", "scenes"],
  "properties": {
    "lesson_id": { "type": "string", "minLength": 1 },
    "language": { "enum": ["en", "hi", "ta"] },
    "total_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "audio_url": { "type": "string", "minLength": 1 },
    "quiz": {
      "description": "Optional, copied unchanged from the lesson (lesson.schema.json #/$defs/quiz); validate.py checks it against that definition. The player shows it after the last scene; the render page and the MP4 ignore it.",
      "type": "array"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "type", "start", "end", "heading", "data", "cues", "beats"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "type": { "enum": ["title_card", "diagram", "code_walkthrough"] },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "heading": { "type": "string" },
          "data": { "type": "object", "required": ["type"] },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "text"],
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 },
                "text": { "type": "string" }
              }
            }
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["t", "action", "value"],
              "properties": {
                "t": { "type": "number", "minimum": 0 },
                "action": { "enum": ["reveal", "highlight"] },
                "value": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
