{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson",
  "description": "Planner output. Contains no duration fields: audio sets scene length (G4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "level", "language", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "level": { "enum": ["beginner", "intermediate"] },
    "language": { "enum": ["en", "hi", "ta"] },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/scene" }
    },
    "quiz": { "$ref": "#/$defs/quiz" },
    "next_topics": { "$ref": "#/$defs/next_topics" },
    "next_topic_labels": { "$ref": "#/$defs/next_topic_labels" },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "next_topics": {
      "description": "Optional (bonus B2): two topics to study next, one step harder or sideways. Always English: it is what the try-next request sends. Validated on its own (validate.py clean_next_topics); invalid ones are dropped, never retried.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 3, "maxLength": 60 }
    },
    "next_topic_labels": {
      "description": "Optional (bonus B2): next_topics in the lesson language (hi, ta), parallel to next_topics, for the button text only.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "quiz": {
      "description": "Optional end-of-lesson quiz (bonus B1). Validated on its own (validate.py clean_quiz): a bad quiz is dropped, never a reason to reject the lesson. Not narrated, so it never changes the timeline. Lengths leave room for Indic scripts; English is held to 160 / 80 / 200.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/quiz_question" }
    },
    "quiz_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "answer_index", "explanation"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 320 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "answer_index": { "type": "integer", "minimum": 0, "maximum": 3 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "meta": {
      "description": "Set by the backend, never by the planner model: where the lesson came from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback"],
      "properties": {
        "fallback": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 80 },
        "topic": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 200, "description": "Why the fallback was used, shown to the user." },
        "translation_fallback": { "type": "boolean", "description": "Translation failed, so the narration stayed in English." },
        "short_of": {
          "description": "The planner wrote less narration than the requested length; kept on its last try rather than falling back. Shown to the user; such a lesson is never reused from the cache.",
          "type": "object",
          "additionalProperties": false,
          "required": ["target_seconds", "words", "target_words"],
          "properties": {
            "target_seconds": { "type": "integer", "minimum": 1 },
            "words": { "type": "integer", "minimum": 0 },
            "target_words": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "narration": { "type": "string", "minLength": 1, "maxLength": 600 },
    "scene": {
      "oneOf": [
        { "$ref": "#/$defs/title_card" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/code_walkthrough" }
      ]
    },
    "title_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "heading", "narration"],
      "properties": {
        "type": { "const": "title_card" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 60 },
        "subheading": { "type": "string", "minLength": 1, "maxLength": 80 },
        "narration": { "$ref": "#/$defs/narration" }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "heading", "layout", "items", "narration"],
      "properties": {
        "type": { "const": "diagram" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 60 },
        "layout": { "enum": ["row", "cycle", "stack"] },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        },
        "arrows": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "integer", "minimum": 0, "maximum": 5 },
              "to": { "type": "integer", "minimum": 0, "maximum": 5 },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 }
            }
          }
        },
        "narration": { "$ref": "#/$defs/narration" }
      }
    },
    "code_walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "heading", "code", "highlight_lines", "narration"],
      "properties": {
        "type": { "const": "code_walkthrough" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 60 },
        "code": {
          "description": "Plain text, max 12 lines of max 50 columns. Displayed as text only (H4).",
          "type": "string",
          "minLength": 1,
          "maxLength": 611,
          "pattern": "^[^\\n]{0,50}(\\n[^\\n]{0,50}){0,11}$"
        },
        "language_hint": { "type": "string", "minLength": 1, "maxLength": 20 },
        "highlight_lines": {
          "description": "1-based line numbers, in the order they are explained.",
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "narration": { "$ref": "#/$defs/narration" }
      }
    }
  }
}
